# The runtime tests/browser/ needs and the gate image lacks: Chromium, and the
# locked dependency set on Python 3.14, production's version. Built by the
# `browser-image` check in [tool.sdlc.ci]; `browser` runs the tests in it.
#
# The project itself is not installed: the repo is mounted at /repo and
# pytest's `pythonpath = ["src"]` imports Trentina from there, so the code
# under test is the checkout, never a copy baked in here. Only pyproject.toml
# and uv.lock are copied, so a source edit reuses every layer.
FROM ghcr.io/astral-sh/uv:0.13.7-python3.14-trixie-slim@sha256:e80c05a310400cfc90af00b5b7271ef9ad24816e3265e1162af8a678e1aad099

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy

# The locked set, with the `browser` group's Playwright, less petit-plus: it is a path source under tests/fixtures,
# which .dockerignore keeps out of the context. --frozen installs uv.lock as
# written; `sdlc ci`'s own `uv sync --locked` holds it to pyproject.toml.
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-extras --group browser --no-install-project \
        --no-install-package petit-plus --no-cache
