# Reference Quadlet unit for a contained Trentina gateway (#268).
# Install to /etc/containers/systemd/ and `systemctl daemon-reload`.
# See docs/deployment-hardening.md for what each line defends against.

[Unit]
Description=Trentina MCP gateway
After=network-online.target

[Container]
Image=quay.io/crunchtools/trentina:latest
ContainerName=trentina
Network=trentina.network
PublishPort=127.0.0.1:8019:8019
# Client egress (--egress-port, 8021) is not published: agents reach it on
# their own internal network. See docs/client-egress.md.
Exec=--transport streamable-http --host 0.0.0.0 --port 8019 --no-dbus

# Containment. TRENTINA_REQUIRE_HARDENED refuses to start without it.
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
User=65532
Environment=TRENTINA_REQUIRE_HARDENED=true

# State: the only writable path besides /tmp.
Volume=/srv/trentina/data:/data:Z

# Config the gateway only READS, still read-only: the trust allowlist, and
# anything else you mount here. The allowlist in particular is administrator-set
# by constitutional rule, so it must not sit in a directory the gateway can
# write.
Volume=/srv/trentina/config:/etc/trentina:ro,Z

# profiles.yaml, in a directory of its OWN, writable, so config_tool can edit
# it (#633). A directory rather than the single file because replacing a file
# atomically means renaming over it, and a rename needs the directory — which
# is exactly why this is a separate mount: the writable surface then holds one
# file instead of every secret and policy file beside it.
#
# The gateway is the only writer, the rootfs stays read-only, nothing here is
# on sys.path, and TRENTINA_REQUIRE_HARDENED still passes (its checks are
# statvfs("/") and the import path, neither of which a bind mount touches).
# For a deployment that wants profiles.yaml hand-edited only, mount this `:ro`
# as well: config_tool reads fine and reports that it cannot write.
Volume=/srv/trentina/live:/etc/trentina-live:Z
Environment=TRENTINA_PROFILES_PATH=/etc/trentina-live/profiles.yaml

# Secrets stay read-only. Every secret by its _FILE form, never inline:
# an environment value stays readable at /proc/self/environ.
Volume=/srv/trentina/secrets:/run/secrets:ro,Z
Environment=TRENTINA_GATEWAY_ENABLED=true
Environment=TRENTINA_OAUTH_JWT_SIGNING_KEY_FILE=/run/secrets/oauth-jwt-signing-key
# Only for backends with auth: {type: oauth} (#479):
#Environment=TRENTINA_BACKEND_TOKEN_KEY_FILE=/run/secrets/backend-token-key
Environment=OPENROUTER_API_KEY_FILE=/run/secrets/openrouter-api-key

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
