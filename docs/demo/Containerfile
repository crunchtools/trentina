# VHS plus what trentina.tape types: python3 for tq, jq to trim its output.
# Built and run by render.sh.
FROM ghcr.io/charmbracelet/vhs:v0.12.1@sha256:ea49a6a1c529be83153e88321892b5585964418f0b9055e8c1e0d732194234a3

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 jq \
 && rm -rf /var/lib/apt/lists/*
